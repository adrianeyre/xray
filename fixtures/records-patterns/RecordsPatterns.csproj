<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The records/pattern matching rung of the ladder (PRD §10): a .NET 8
    console app whose behaviour turns on records and record structs, the
    members the compiler writes for them, init-only setters, and patterns
    (type, property, positional, relational, logical and list) in is
    expressions, switch statements and switch expressions, all of which the
    compiler lowers to members and branches a Reconstruction must turn back
    into C#.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
