<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for the cyclic-reference Fixture's program, with its assembly
    name and the one type the plugin uses, so the plugin can be built against
    it before the program is.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>CyclicReference</AssemblyName>
    <!-- Restore tells projects apart by package ID, which is otherwise the assembly name. -->
    <PackageId>HostContract</PackageId>
  </PropertyGroup>

</Project>
