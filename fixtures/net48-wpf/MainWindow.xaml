<Window x:Class="Swatches.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Swatches"
        xmlns:controls="clr-namespace:Swatches.Controls"
        Title="{Binding Hex, StringFormat='Swatches {0}'}" Width="420" Height="380"
        Icon="pack://application:,,,/Assets/swatches.png"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <local:MixerViewModel />
    </Window.DataContext>
    <Grid Margin="{StaticResource Gutter}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Caption}" Text="Red" />
        <Slider x:Name="redSlider" Grid.Column="1" Value="{Binding Red}" />
        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Value, ElementName=redSlider, StringFormat=N0}" />
        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="Green" />
        <Slider x:Name="greenSlider" Grid.Row="1" Grid.Column="1" Value="{Binding Green}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Value, ElementName=greenSlider, StringFormat=N0}" />
        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Blue" />
        <Slider x:Name="blueSlider" Grid.Row="2" Grid.Column="1" Value="{Binding Blue}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Value, ElementName=blueSlider, StringFormat=N0}" />
        <Border x:Name="preview" Grid.Row="3" Grid.ColumnSpan="3" Height="48" Margin="{StaticResource Gutter}" CornerRadius="4"
                Background="{Binding Color, Converter={StaticResource ColorToBrush}}">
            <TextBlock Style="{StaticResource HexText}" HorizontalAlignment="Center" Text="{Binding Hex}" />
        </Border>
        <DockPanel Grid.Row="4" Grid.ColumnSpan="3">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="_Save" IsDefault="True" Command="{Binding SaveCommand}" />
            <TextBox x:Name="nameBox" Margin="{StaticResource Gutter}" VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <ListBox x:Name="savedList" Grid.Row="5" Grid.ColumnSpan="3" Margin="{StaticResource Gutter}" ItemsSource="{Binding Saved}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:Swatch}">
                    <StackPanel Orientation="Horizontal">
                        <controls:SwatchChip Color="{Binding Color}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
