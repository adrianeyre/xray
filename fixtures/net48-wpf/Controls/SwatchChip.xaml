<UserControl x:Class="Swatches.Controls.SwatchChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="24" Height="24">
    <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="1" CornerRadius="4"
            Background="{Binding Color, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrush}}" />
</UserControl>
