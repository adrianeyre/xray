<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="Accent">#FF2E7D32</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <Thickness x:Key="Gutter">12</Thickness>
    <CornerRadius x:Key="BadgeCorner">6</CornerRadius>
    <sys:Double x:Key="BadgeFontSize">28</sys:Double>
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
</ResourceDictionary>
