  {
    "args": ["variance"],
    "expected": {
      "stdout": [
        "a producer of strings, as a producer of objects, produces hello",
        "a consumer of objects, as a consumer of strings: Object describer got text",
        "a Transform<Object, String> as a Transform<String, Object> gives <x>",
        "a Constant<String> is an IProducer<Object>: True, an IBox<String>: True, an IBox<Object>: False",
        "a Describer<Object> is an IConsumer<String>: True; a Describer<String> is an IConsumer<Object>: False",
        "a Describer<String> as an IConsumer<Object> consumes nothing",
        "a List<String> is an IEnumerable<Object>: True, an IReadOnlyList<Object>: True, an IList<Object>: False",
        "storing an int in a string[] seen as an object[] throws ArrayTypeMismatchException"
      ],
      "stderr": [],
      "exitCode": 0
    }
