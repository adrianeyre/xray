  {
    "args": ["constraints"],
    "expected": {
      "stdout": [
        "ArrayStack<T>: T",
        "Pair<TFirst, TSecond>: TFirst; TSecond",
        "IProducer<T>: T (out)",
        "IConsumer<T>: T (in)",
        "Transform<T, TResult>: T (in); TResult (out)",
        "IBox<T>: T",
        "IMonoid<TSelf>: TSelf (IMonoid<TSelf>)",
        "Registry<T>: T",
        "Algorithms.Describe<T>: T",
        "Algorithms.Make<T>: T (new())",
        "Algorithms.Max<T>: T (IComparable<T>)",
        "Algorithms.NameOf<TEnum>: TEnum (struct, new(), Enum, ValueType)",
        "Algorithms.OrDefault<T>: T (struct, new(), ValueType)",
        "Algorithms.SizeOf<T>: T (struct, new(), unmanaged, ValueType)",
        "Algorithms.Swap<T>: T",
        "Algorithms.TopOrNull<T>: T (class)",
        "Algorithms.Upcast<TDerived, TBase>: TDerived (TBase); TBase",
        "Formatter.Format<T>: T (IFormattable)",
        "HexFormatter.Format<T>: T (IFormattable)",
        "Monoid.Concat<T>: T (IMonoid<T>)",
