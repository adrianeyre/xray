<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A .NET Standard 2.0 class library, Measures, and a .NET 8 console app that
    uses it (PRD FR-8). Measures is built beside this program's Assembly, as a
    Sibling Assembly, so a Reconstruction makes it a netstandard2.0 project
    again.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The library's sources are its own project's, not this one's. -->
    <Compile Remove="Measures/**" />
    <ProjectReference Include="Measures/Measures.csproj" />
  </ItemGroup>

</Project>
